# ==============================================================================
# AQUAINTEL CONFIGURATION & ENVIRONMENT VARIABLES
# Smart Prawn Farm Automation & AI-Based Disease Risk Management
# ==============================================================================

# Project & Security
PROJECT_NAME="AQUAINTEL - Smart Prawn Farm Automation"
VERSION="1.0.0"
SECRET_KEY="aquaintel-production-secure-random-token-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite (Embedded, zero configuration required)
# Production PostgreSQL URL format:
# DATABASE_URL=postgresql://aquaintel_user:secure_password@localhost:5432/aquaintel_db
DATABASE_URL="sqlite:///./aquaintel.db"

# 10 Hectare Farm Settings
FARM_TOTAL_HECTARES=10.0
TOTAL_PONDS=10
POND_SIZE_HA=1.0

# Connectivity & Telemetry
LORA_FREQUENCY_MHZ=865.2
LORA_BAND="IN865"
LORA_GATEWAY_IP="192.168.1.1"

# Alert Integration Placeholders (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
WHATSAPP_API_TOKEN=""
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
