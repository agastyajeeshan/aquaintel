# ==============================================================================
# AQUAINTEL FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env or .env.local for local overrides. Do NOT commit production credentials.
# ==============================================================================

# API Base URL (FastAPI backend)
# Local Vite Dev default: http://localhost:8000/api
# Production reverse proxy default: /api
VITE_API_BASE_URL=http://localhost:8000/api

# Real-Time Telemetry WebSocket Base URL
# Local Vite Dev default: ws://localhost:8000/ws/telemetry
# Production TLS default: wss://farm.aquaintel.io/ws/telemetry
VITE_WS_BASE_URL=ws://localhost:8000/ws/telemetry

# Request Timeout (milliseconds)
VITE_API_TIMEOUT_MS=15000

# Authentication Token Storage Key
VITE_AUTH_TOKEN_KEY=aquaintel_auth_token
